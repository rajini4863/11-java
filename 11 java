<%@ page import="java.sql.*" %><html><head><title>Database Access in JSP</title></head><body><h2>Student Records</h2><%Connection con = null;Statement st = null;ResultSet rs = null;try {// Load DriverClass.forName("com.mysql.cj.jdbc.Driver");// Connect to databasecon = DriverManager.getConnection("jdbc:mysql://localhost:3306/studentdb","root","password");st = con.createStatement();// Queryrs = st.executeQuery("SELECT * FROM student");%><table border="1"><tr><th>Roll No</th><th>Name</th><th>Address</th></tr><%while(rs.next()) {%><tr><td><%= rs.getInt(1) %></td><td><%= rs.getString(2) %></td><td><%= rs.getString(3) %></td></tr><%}%></table><%} catch(Exception e) {out.println("Error: " + e);} finally {if(rs != null) rs.close();if(st != null) st.close();if(con != null) con.close();}%></body></html>
